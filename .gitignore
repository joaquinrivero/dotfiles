omp/.omp/logs/
omp/.omp/natives/

# pi agent runtime state (SYSTEM/APPEND_SYSTEM + settings.json stay tracked)
pi/.pi/agent/auth.json
pi/.pi/agent/models-store.json
pi/.pi/agent/slicc-adobe-session.json
pi/.pi/agent/bin/
pi/.pi/agent/extensions/
pi/.pi/agent/git/
pi/.pi/agent/sessions/

# App-rewritten runtime state (templates are the tracked source)
