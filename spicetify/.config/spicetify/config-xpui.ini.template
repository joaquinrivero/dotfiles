[Setting]
current_theme          = catppuccin
inject_css             = 1
spotify_launch_flags   = 
always_enable_devtools = 0
spotify_path           = /Applications/Spotify.app/Contents/Resources
prefs_path             = ${HOME}/Library/Application Support/Spotify/prefs
color_scheme           = mocha
inject_theme_js        = 1
replace_colors         = 1
overwrite_assets       = 1
check_spicetify_update = 1

[Preprocesses]
expose_apis        = 1
disable_sentry     = 1
disable_ui_logging = 1
remove_rtl_rule    = 1

[AdditionalOptions]
extensions            = 
custom_apps           = 
sidebar_config        = 0
home_config           = 1
experimental_features = 1

