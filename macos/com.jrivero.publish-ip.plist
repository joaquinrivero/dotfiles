<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.jrivero.publish-ip</string>
<key>ProgramArguments</key><array><string>$HOME/.local/bin/publish-ip.sh</string></array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>StandardOutPath</key><string>$HOME/.cache/publish-ip.log</string>
<key>StandardErrorPath</key><string>$HOME/.cache/publish-ip.log</string>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>300</integer>
</dict></plist>
